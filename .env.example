# Copy to a private environment or export these in the shell.
# Do not commit real values. Do not paste keys into the notebook saved on GitHub.

# Control-plane token. Required when NEXUS binds beyond loopback.
# NEXUS_AUTH_TOKEN=

# KiosAPI credential. Prefer the UI password field or Colab secrets.
# NEXUS_KIOSAPI_API_KEY=

# Defaults match the requested integration and can be changed in the UI.
NEXUS_KIOS_HOST=https://mp.kaggle.net
NEXUS_KIOS_MODEL=kiosapi/north-mini-code
NEXUS_KIOS_WIRE_FORMAT=anthropic_messages

# Bind loopback unless you intentionally publish the control plane.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8787

# Optional absolute interpreter for the unmodified Free Claude Code engine.
# Upstream requires Python 3.14.7. NEXUS will not pretend another interpreter is compatible.
# NEXUS_FCC_PYTHON=

# Optional OpenCode 2 binary. Otherwise NEXUS looks up `opencode` on PATH.
# NEXUS_OPENCODE_BIN=
